# Warning policy for project targets (third-party code is never touched) and the sanitizer switch.
option(BW_WERROR "Treat warnings in project code as errors" OFF)
option(BW_SANITIZE "Build with AddressSanitizer (+ UBSan where the compiler has it)" OFF)

function(bw_apply_compiler_policy target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
        if(BW_WERROR)
            target_compile_options(${target} PRIVATE /WX)
        endif()
        if(BW_SANITIZE)
            target_compile_options(${target} PRIVATE /fsanitize=address)
            target_compile_definitions(${target} PRIVATE _DISABLE_VECTOR_ANNOTATION _DISABLE_STRING_ANNOTATION)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra)
        if(BW_WERROR)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
        if(BW_SANITIZE)
            target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=address,undefined)
        endif()
    endif()
endfunction()
